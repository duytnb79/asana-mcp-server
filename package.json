{
  "name": "@duytnb79/asana-mcp",
  "version": "0.1.0",
  "description": "Asana MCP server with personal access token authentication",
  "type": "module",
  "bin": {
    "asana-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "scripts",
    "README.md",
    ".env.example"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test:connection": "node scripts/test-connection.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/duytnb79/asana-mcp-server.git"
  },
  "homepage": "https://github.com/duytnb79/asana-mcp-server#readme",
  "bugs": {
    "url": "https://github.com/duytnb79/asana-mcp-server/issues"
  },
  "keywords": [
    "mcp",
    "asana",
    "personal-access-token"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "dotenv": "17.4.2",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "tsx": "4.23.1",
    "typescript": "5.9.3"
  }
}
